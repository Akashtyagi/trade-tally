SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,trade-tally,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SQLite is used inside the Podman container (/data/db.sqlite3).
# Leave these for a rare host-only run:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Zerodha Kite Connect — see docs/06-integrations-setup.md
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_API_BASE_URL=https://api.kite.trade
KITE_REDIRECT_URL=http://127.0.0.1:8000/kite/callback/

# Google Sheets — file is mounted from ./secrets/google-credentials.json in Podman
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Aug24-27
SHEET_COLUMN_MAP={}

# Telegram — see docs/06-integrations-setup.md
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=

# In-container APScheduler stays off; host cron talks to the container
ENABLE_SCHEDULER=false
CHECK_INTERVAL_MINUTES=60
CRON_SECRET=change-me-cron-secret
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
